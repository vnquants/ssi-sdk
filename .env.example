# SSI FastConnect V3 API credentials (iBoard > API key management).
SSI_API_KEY=
SSI_API_SECRET=

# RSA private key (base64-encoded XML RSAKeyValue or PEM PKCS#1/PKCS#8).
# Optional for read-only queries; required for placing, modifying or cancelling orders and FCOs.
SSI_PRIVATE_KEY=

# Optional client identifier sent on balance and position queries when configured.
# SSI_CLIENT_ID=

# Optional overrides of the production V3 endpoints.
# SSI_V3_API_URL=https://api.ssi.com.vn
# SSI_V3_TRADING_URL=https://api.ssi.com.vn
# SSI_V3_STREAM_URL=wss://stream.ssi.com.vn/ws/v3
# SSI_V3_TRADING_WS_URL=wss://api.ssi.com.vn/ws/v3/trading
